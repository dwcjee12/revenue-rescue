# Public address of this server. OAuth redirect URIs are built from it, so it must match what you register with each provider.
BASE_URL=https://app.yourdomain.com
PORT=3000
# 32 random bytes as 64 hex characters (openssl rand -hex 32). Encrypts stored credentials. Keep it backed up: losing it disconnects every integration.
ENCRYPTION_KEY=
DATA_DIR=./data

# OAuth apps you register once as the operator (leave blank to hide sign-in for that provider):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# SALESFORCE_LOGIN_URL=https://login.salesforce.com
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=
# DOCUSIGN_ENV=demo   (use prod for live)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_ENV=sandbox
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
# Only for docker-compose (Caddy HTTPS): your domain, no https://
DOMAIN=app.yourdomain.com
